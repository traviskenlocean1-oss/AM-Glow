{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "am-glow",
  "compatibility_date": "2026-08-30",
  "observability": {
    "enabled": true
  },
  "main": "worker/index.js",
  // Keep the workers.dev URL alive alongside the custom domain.
  "workers_dev": true,
  // Her real domain (bought on Namecheap, nameservers pointed at Cloudflare).
  "routes": [
    { "pattern": "amglowup.com", "custom_domain": true },
    { "pattern": "www.amglowup.com", "custom_domain": true }
  ],
  // The Worker runs first on every request so it can 301 www -> apex; it
  // handles /api/* itself and hands everything else to static assets.
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  // Public Square Application ID (it ships to the browser anyway). The
  // access token is a secret: `npx wrangler secret put SQUARE_ACCESS_TOKEN`.
  "vars": {
    "SQUARE_APP_ID": "sq0idp-YCXHUPV4MmRrr7P1VA6VHw",
    // Formspree form that emails each order to the owner's Gmail.
    "FORMSPREE_ORDER_FORM_ID": "mnpjpzvp"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
